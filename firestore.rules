rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /universities/{universityId} {
      allow read, write: if request.auth != null && request.auth.uid == universityId;

      match /staff/{staffId} {
        allow read, write: if request.auth != null && request.auth.uid == universityId;
      }
      match /invitations/{inviteId} {
        allow read, write: if request.auth != null && request.auth.uid == universityId;
      }
      match /audit_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == universityId;
      }
      match /notifications/{notifId} {
        allow read, write: if request.auth != null && request.auth.uid == universityId;
      }
    }

    match /applications/{appId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.universityId ||
        request.auth.uid == resource.data.studentId
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.universityId ||
        request.auth.uid == resource.data.studentId
      );
    }

    match /programs/{programId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.universityId;
      allow create: if request.auth != null;
    }

    match /scholarships/{scholarshipId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /payments/{paymentId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.universityId
      );
    }

    match /documents/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /notifications/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
  }
}